<Window x:Class="RonVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RonVoice" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!--
            A barra fica fixa embaixo, visivel em todas as abas: as tres falhas
            do sistema sao invisiveis, e esta linha e' onde elas ficam ditas.
        -->
        <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="10,6">
            <TextBlock Text="{Binding StatusBar.Summary}"
                       Foreground="#DDDDDD" FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="8">
            <TabItem Header="Comandos">
                <ContentControl x:Name="CommandsHost" />
            </TabItem>
            <TabItem Header="Teste">
                <ContentControl x:Name="TestHost" />
            </TabItem>
            <TabItem Header="Configuração">
                <ContentControl x:Name="SettingsHost" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
