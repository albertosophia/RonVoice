<Window x:Class="RonVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RonVoice.App.Views"
        Title="RonVoice" Height="680" Width="940" MinWidth="720" MinHeight="480"
        Background="{StaticResource Panel}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!--
            A barra de estado fica no TOPO, nao no rodape. E' a primeira pergunta
            de quem diz "nao funciona", e no rodape ninguem olhava. As fichas de
            falha vem na frente das informativas — numa linha corrida de texto o
            problema ficava no meio.
        -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Deep}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <ItemsControl ItemsSource="{Binding StatusBar.Chips}"
                          ItemTemplate="{StaticResource StatusChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    Background="{StaticResource Panel}">
            <TabControl.Resources>
                <!-- A faixa das abas continua no tom da barra, para a aba ativa
                     parecer ligada ao conteudo e nao flutuando. -->
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{StaticResource Deep}" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="Comandos">
                <views:CommandsView DataContext="{Binding Commands}" />
            </TabItem>
            <TabItem Header="Teste de voz">
                <views:TestView DataContext="{Binding Test}" />
            </TabItem>
            <TabItem Header="Configuração">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
