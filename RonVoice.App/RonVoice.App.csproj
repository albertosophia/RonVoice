<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!--
      O executável se chama RonVoice.exe, e não RonVoice.App.exe: o ".App" é
      nome de projeto, não nome de programa, e quem baixa o zip não tem por que
      saber como o código está dividido.
    -->
    <AssemblyName>RonVoice</AssemblyName>
    <!-- Gerado por tools/make_icon.py; não editar à mão. -->
    <ApplicationIcon>RonVoice.ico</ApplicationIcon>
    <!-- interop apenas pelo NotifyIcon; não há Form neste app -->
    <!-- exigido pelo gerador do LibraryImport usado nos hooks (SYSLIB1062) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Este app é WPF; o WinForms entra só pelo NotifyIcon. Sem remover o using
      implícito, `Application` fica ambíguo entre os dois frameworks em todo
      arquivo. Quem precisa de WinForms declara o using explicitamente.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RonVoice.Core\RonVoice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../data/ron_commands.json" Link="data/ron_commands.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
