<UserControl x:Class="RonVoice.App.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="20" MaxWidth="620" HorizontalAlignment="Left">

        <TextBlock Text="A minha voz está funcionando?" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Clique no botão, fale uma frase de comando, e clique de novo para parar. Nada é enviado ao jogo neste teste." />

        <Button Padding="16,10" FontSize="14" HorizontalAlignment="Left"
                Command="{Binding ToggleRecordingCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="Testar minha voz" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Content" Value="Parar e ver o resultado" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!--
            O medidor separa "microfone mudo" de "pronuncia nao entendida" antes
            de qualquer reconhecimento: se a barra nao se mexe, acabou a
            investigacao.
        -->
        <StackPanel Margin="0,16,0,0"
                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="nível de entrada" Foreground="{StaticResource Muted}" FontSize="11" />
            <ProgressBar Height="18" Minimum="0" Maximum="1"
                         Value="{Binding Level, Mode=OneWay}" />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Se esta barra não se mexer enquanto você fala, o problema é o microfone — não a pronúncia." />
        </StackPanel>

        <!--
            O veredito. O fundo e a tinta mudam JUNTOS: um fundo claro com a
            tinta clara do tema deixava o resultado ilegivel — que e' o pior
            lugar possivel para isso, porque esta tela existe para ser lida
            quando algo nao funciona.
        -->
        <Border Margin="0,20,0,0" Padding="14" CornerRadius="4" BorderThickness="1"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource CritFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CritLine}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                            <Setter Property="Background" Value="{StaticResource OkFill}" />
                            <Setter Property="BorderBrush" Value="{StaticResource OkLine}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap"
                           FontSize="14" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource CritInk}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource OkInk}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
