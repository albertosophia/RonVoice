<UserControl x:Class="RonVoice.App.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Panel}">

    <DockPanel Margin="18,14,18,0">

        <StackPanel DockPanel.Dock="Top">

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Limpar" VerticalAlignment="Top"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ClearCommand}" />
                <StackPanel>
                    <TextBlock Text="Teste de voz" FontFamily="{StaticResource TechFont}"
                               FontSize="16" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                               Text="Fale os comandos. Cada frase sobe na lista. Nada é enviado ao jogo aqui." />
                </StackPanel>
            </DockPanel>

            <!--
                O medidor separa "microfone mudo" de "pronuncia nao entendida"
                antes de qualquer reconhecimento: se a barra nao se mexe, acabou
                a investigacao. Fica sempre visivel, porque uma lista parada e'
                indistinguivel de um microfone morto.
            -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Chip}" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Dim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Listening}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="parado" />
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Listening}" Value="True">
                                            <Setter Property="Text" Value="escutando" />
                                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ProgressBar Grid.Column="1" Height="16" Minimum="0" Maximum="1"
                             Value="{Binding Level, Mode=OneWay}" />
            </Grid>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,0" />

        </StackPanel>

        <!-- Nada dito ainda. -->
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,20,0,0"
                   TextAlignment="Center"
                   Text="Fale um comando — &quot;stack up&quot;, &quot;open with flashbang&quot;."
                   Visibility="{Binding HasNothingYet, Converter={StaticResource Bool2Vis}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="0,4,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1" Padding="0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                           Style="{StaticResource Mono}"
                                           VerticalAlignment="Top" Margin="0,2,12,0" />

                                <!-- A marca carrega o estado sozinha, para quem
                                     nao distingue as cores. -->
                                <TextBlock x:Name="mark" Grid.Column="1" Text="✕"
                                           FontSize="14" Width="20"
                                           Foreground="{StaticResource Crit}"
                                           VerticalAlignment="Top" />

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="heard" FontSize="14"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Ink}">
                                        <Run Text="&#x201C;" /><Run Text="{Binding Heard, Mode=OneWay}" /><Run Text="&#x201D;" />
                                    </TextBlock>
                                    <TextBlock x:Name="title" Text="{Binding Title}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource Muted}"
                                               Visibility="{Binding HasTitle,
                                                            Converter={StaticResource Bool2Vis}}" />
                                </StackPanel>

                                <Border Grid.Column="3" CornerRadius="3" Padding="7,2"
                                        Margin="10,1,0,0" VerticalAlignment="Top"
                                        Background="{StaticResource SignalFill}"
                                        BorderBrush="{StaticResource SignalLine}"
                                        BorderThickness="1"
                                        Visibility="{Binding HasKeys,
                                                     Converter={StaticResource Bool2Vis}}">
                                    <TextBlock Text="{Binding Keys}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource Signal}" />
                                </Border>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                <Setter TargetName="mark" Property="Text" Value="✓" />
                                <Setter TargetName="mark" Property="Foreground"
                                        Value="{StaticResource Ok}" />
                                <Setter TargetName="heard" Property="Foreground"
                                        Value="{StaticResource OkInk}" />
                            </DataTrigger>

                            <!-- Ausencia, nao erro: ele entendeu, e o mod e' que
                                 nao tem a ordem. Vermelho aqui mandaria a pessoa
                                 caçar pronuncia sem problema nenhum. -->
                            <DataTrigger Binding="{Binding IsNotInMod}" Value="True">
                                <Setter TargetName="mark" Property="Text" Value="●" />
                                <Setter TargetName="mark" Property="Foreground"
                                        Value="{StaticResource Dim}" />
                                <Setter TargetName="heard" Property="Foreground"
                                        Value="{StaticResource Muted}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                <Setter TargetName="mark" Property="Text" Value="▲" />
                                <Setter TargetName="mark" Property="Foreground"
                                        Value="{StaticResource Signal}" />
                                <Setter TargetName="heard" Property="Foreground"
                                        Value="{StaticResource Signal}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsBad}" Value="True">
                                <Setter TargetName="heard" Property="Foreground"
                                        Value="{StaticResource CritInk}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
