<UserControl x:Class="RonVoice.App.Views.ChecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RonVoice.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:CheckStatusBrushConverter x:Key="StatusBrush" />
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="14">
        <StackPanel>

            <TextBlock Text="Está tudo certo?" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"
                       Text="Verifica elevação, modelo de voz, microfone, jogo e teclas. A do microfone pede que você fale." />

            <Button Content="Verificar tudo" Padding="14,5" HorizontalAlignment="Left"
                    Command="{Binding RunCommand}" />

            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding Listening, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Fale alguma coisa para eu testar o microfone"
                           FontSize="12" Margin="0,0,0,4" />
                <ProgressBar Height="16" Minimum="0" Maximum="1"
                             Value="{Binding Level, Mode=OneWay}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Results}" Margin="0,12,0,0"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10"
                                     VerticalAlignment="Top" Margin="0,4,8,0"
                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="12" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                           FontSize="11" Foreground="{StaticResource Dim}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fundo e tinta mudam juntos, senao o veredito fica ilegivel. -->
            <Border Margin="0,12,0,0" Padding="10" CornerRadius="4" BorderThickness="1"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CritFill}" />
                        <Setter Property="BorderBrush" Value="{StaticResource CritLine}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Ready}" Value="True">
                                <Setter Property="Background" Value="{StaticResource OkFill}" />
                                <Setter Property="BorderBrush" Value="{StaticResource OkLine}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource CritInk}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ready}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource OkInk}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
