<UserControl x:Class="RonVoice.App.Views.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
    </UserControl.Resources>

    <DockPanel Margin="6">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="O que você pode falar" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"
                       Text="Fale qualquer uma das frases abaixo com o jogo em foco. O contexto diz para onde você precisa estar olhando." />
            <!--
                Avisos do minhas_frases.json. Ficam na tela, nao num log: quem
                escreveu o arquivo precisa ver que uma linha dele foi recusada.
            -->
            <Border Background="#FFF3CD" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Recarregar" Padding="10,4"
                            Margin="10,0,0,0" VerticalAlignment="Top"
                            Command="{Binding ReloadCommand}" />
                    <StackPanel>
                        <TextBlock Text="Suas frases — algumas não entraram:"
                                   FontWeight="SemiBold" FontSize="12" Foreground="#856404" />
                        <TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#856404" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--
                A frase entra no catalogo na hora, mas a gramatica do Vosk e'
                montada na abertura e e' imutavel. Sem este aviso o usuario
                fala a frase nova, nada acontece, e nao ha erro nenhum.
            -->
            <Border Background="#E3F2FD" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                    Visibility="{Binding PendingRestart, Converter={StaticResource Bool2Vis}}">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#0D47A1"
                           Text="Suas frases já estão gravadas. Reabra o RonVoice para o reconhecimento passar a ouvi-las — a gramática só é montada na abertura." />
            </Border>

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="#888" Text="{Binding CountText}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="13" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                       FontSize="13" Margin="0,0,0,4" Foreground="#3A6EA5" />

                            <ItemsControl ItemsSource="{Binding Orders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1"
                                                Padding="6,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding PathText}"
                                                                   Foreground="#999" FontSize="11"
                                                                   Margin="10,1,0,0" />
                                                        <!--
                                                            As 25 ordens confidence: verify nunca
                                                            foram confirmadas em jogo. Sem o selo,
                                                            viram "esse comando esta quebrado".
                                                        -->
                                                        <Border Background="#FFF3CD"
                                                                CornerRadius="3" Padding="5,1"
                                                                Margin="10,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NeedsVerification}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="não verificado em jogo"
                                                                       FontSize="10" Foreground="#856404" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding PhrasesEnText}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding PhrasesPtText}"
                                                               TextWrapping="Wrap"
                                                               FontSize="12" Foreground="#666" />

                                                    <!--
                                                        Frases do usuario, uma por ficha, com o
                                                        x que remove. Sao dele: da' para tirar.
                                                    -->
                                                    <ItemsControl ItemsSource="{Binding CustomPhrases}"
                                                                  Margin="0,2,0,0"
                                                                  Visibility="{Binding HasCustomPhrases,
                                                                               Converter={StaticResource Bool2Vis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <!--
                                                                No x, o ItemsControl mais proximo e' o
                                                                das fichas: o DataContext dele e' a ordem.
                                                            -->
                                                            <DataTemplate>
                                                                <Border Background="#E8F5E9" CornerRadius="3"
                                                                        Padding="6,1" Margin="0,2,4,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding}" FontSize="12"
                                                                                   Foreground="#2E7D32"
                                                                                   VerticalAlignment="Center" />
                                                                        <Button Content="✕" FontSize="10" Padding="4,0"
                                                                                Margin="5,0,0,0" BorderThickness="0"
                                                                                Background="Transparent"
                                                                                Foreground="#2E7D32"
                                                                                ToolTip="Remover esta frase"
                                                                                Command="{Binding DataContext.RemoveCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Editor, escondido ate' pedirem: sao 70 linhas. -->
                                                    <StackPanel Margin="0,6,0,0"
                                                                Visibility="{Binding IsChecked, ElementName=EditToggle,
                                                                             Converter={StaticResource Bool2Vis}}">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Adicionar"
                                                                    Padding="10,3" Margin="6,0,0,0"
                                                                    Command="{Binding AddCommand}" />
                                                            <TextBox Padding="5,3" FontSize="12"
                                                                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Return"
                                                                                Command="{Binding AddCommand}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding DraftError}" TextWrapping="Wrap"
                                                                   FontSize="11" Foreground="#C62828" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasDraftError,
                                                                                Converter={StaticResource Bool2Vis}}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                            VerticalAlignment="Top">
                                                    <Button Content="Enviar ao jogo" Padding="10,4"
                                                            Command="{Binding DataContext.SendCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <ToggleButton x:Name="EditToggle" Content="+ minha frase"
                                                                  Padding="10,3" Margin="0,4,0,0" FontSize="11"
                                                                  Visibility="{Binding DataContext.CanEdit,
                                                                               RelativeSource={RelativeSource AncestorType=UserControl},
                                                                               Converter={StaticResource Bool2Vis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
